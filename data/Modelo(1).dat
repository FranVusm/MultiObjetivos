# =========================================================
# CASO DE PRUEBA INTERMEDIO (6 CLIENTES, 3 PERIODOS)
# =========================================================

# CONJUNTOS BASE
set N := 1 2 3 4 5 6 7 20;  # 1:Origen, 2..7:Clientes, 20:Dummy
set P := 1 2 3;             # 1:Mañana, 2:Tarde, 3:Noche
set K := 1 2;               # 2 vehiculos disponibles
set V := 1 2;               # 2 vueltas maximas

# PONDERADORES (9 Puntos del Frente de Pareto)
param sigma: 1 2 :=
1   0.1 0.9
2   0.2 0.8
3   0.3 0.7
4   0.4 0.6
5   0.5 0.5
6   0.6 0.4
7   0.7 0.3
8   0.8 0.2
9   0.9 0.1
;

# PARAMETROS GENERALES
param O := 1;
param q := 1500; # Capacidad aumentada para soportar más clientes

param d :=
1   0
2   200
3   300
4   400
5   250
6   350
7   200
20  0
;

